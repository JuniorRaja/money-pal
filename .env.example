# Supabase — same project, two spellings: VITE_* is inlined into the browser
# bundle at build time, the unprefixed ones are read at runtime by SSR/server fns.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# AI assistant — set one. ANTHROPIC_API_KEY wins if both are present.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-opus-5

# Playwright e2e login
TESTING_USERID=
TESTING_PASSWORD=
